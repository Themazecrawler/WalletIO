# WalletIO optional integrations.
# Copy this file to `.env` and fill in real values to go live.
# Leave everything unset to run in simulated demo mode (works out of the box).

# Supabase project credentials (create a free project at https://supabase.com/dashboard)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Sentry error monitoring DSN (create a project at https://sentry.io)
VITE_SENTRY_DSN=""

# Presentation: show the phone mockup (status bar / notch / "WalletIO OS" footer).
# 1 = always framed, 0 = always full-screen. Unset = framed in dev only.
VITE_DEVICE_FRAME=""
